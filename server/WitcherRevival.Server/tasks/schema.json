{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Monster Slayer task files, schema 1",
  "$defs": {
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "item",
        "amount"
      ],
      "properties": {
        "type": {
          "enum": [
            1,
            2,
            3,
            4,
            5,
            6,
            16
          ]
        },
        "item": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "slug",
        "type",
        "target"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 1000000
        },
        "slug": {
          "type": "string",
          "pattern": "^[a-z0-9_]{1,96}$"
        },
        "type": {
          "enum": [
            1,
            2,
            3,
            4,
            6,
            7,
            8,
            9,
            10,
            11,
            12,
            13
          ]
        },
        "target": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2000000
        },
        "gold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "min_level": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "weight": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "item_type": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "fights": {
          "type": "integer",
          "minimum": 0,
          "maximum": 128
        },
        "monsters": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "items": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "actions": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "quests": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "outputs": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2147483647
          }
        },
        "rewards": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/reward"
          }
        },
        "evidence": {
          "enum": [
            "Client",
            "Community",
            "Authored"
          ]
        },
        "window_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 86400
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": 3
              }
            }
          },
          "else": {
            "properties": {
              "target": {
                "maximum": 10000
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": 1
              }
            }
          },
          "else": {
            "properties": {
              "window_seconds": {
                "const": 0
              }
            }
          }
        },
        {
          "if": {
            "required": [
              "window_seconds"
            ],
            "properties": {
              "window_seconds": {
                "minimum": 1
              }
            }
          },
          "then": {
            "properties": {
              "target": {
                "minimum": 2
              }
            }
          }
        }
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "start",
        "end",
        "gold",
        "tasks",
        "rewards"
      ],
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "gold": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/definition"
          }
        },
        "rewards": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/reward"
          }
        }
      }
    }
  },
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "tasks"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "tasks": {
          "type": "array",
          "minItems": 3,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/definition"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "size",
        "streak",
        "reward_id",
        "reward"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31
        },
        "streak": {
          "type": "boolean"
        },
        "reward_id": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "reward": {
          "$ref": "#/$defs/reward"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "events"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "events": {
          "type": "array",
          "minItems": 0,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "trinkets"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "trinkets": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "items": {
            "$ref": "#/$defs/definition"
          }
        }
      }
    }
  ]
}
