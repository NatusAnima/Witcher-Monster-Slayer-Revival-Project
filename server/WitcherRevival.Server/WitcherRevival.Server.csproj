<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>WitcherRevival.Server</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Admin/ui/*" LogicalName="admin/%(Filename)%(Extension)" />
    <Content Update="news/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="tasks/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- Season 1 story, generated by server/story-1.1.116/season1_story.py -->
    <EmbeddedResource Include="Story/season1-story.json" LogicalName="season1-story.json" />
    <EmbeddedResource Include="Story/world-bestiary.json" LogicalName="world-bestiary.json" />
  </ItemGroup>

</Project>
